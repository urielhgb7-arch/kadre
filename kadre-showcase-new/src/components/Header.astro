---
const links = [
  { href: "/", label: "Templates" },
  { href: "#features", label: "Fonctionnalités" },
  { href: "#pricing", label: "Prix" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 h-[72px] flex items-center justify-between px-6 transition-all duration-400 bg-gray-950/80 backdrop-blur-xl border-b border-white/10 shadow-lg">
  <div class="max-w-7xl w-full mx-auto flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 text-xl font-bold font-heading tracking-tight text-white hover:opacity-80 transition-opacity">
      Kadrify<span class="text-[#00E5FF]">.</span>
    </a>
    
    <nav class="hidden md:flex items-center gap-2">
      {links.map((link) => (
        <a href={link.href} class="px-4 py-2 text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
          {link.label}
        </a>
      ))}
    </nav>
    
    <div class="flex items-center gap-3">
      <!-- Theme Switcher -->
      <div class="theme-switcher-wrap relative" id="theme-switcher-wrap">
        <button 
          id="theme-switcher-btn"
          aria-label="Changer de thème"
          title="Changer de thème (Clair / Sombre / Système)"
          class="flex items-center gap-1.5 px-3 py-2 rounded-lg border border-white/10 bg-white/5 hover:bg-white/10 text-gray-400 hover:text-white transition-all duration-200 text-sm font-medium"
        >
          <span id="theme-switcher-icon" class="flex items-center">
            <!-- filled dynamically -->
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </span>
          <span id="theme-switcher-label" class="hidden sm:inline text-xs">Sombre</span>
        </button>

        <!-- Dropdown -->
        <div id="theme-dropdown" class="hidden absolute right-0 top-full mt-2 w-44 bg-gray-900/95 backdrop-blur-xl border border-white/10 rounded-xl shadow-xl overflow-hidden z-50">
          <button data-theme="dark" class="theme-option flex items-center gap-3 w-full px-4 py-3 text-sm text-gray-300 hover:bg-white/5 hover:text-white transition-colors">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            Sombre
          </button>
          <button data-theme="light" class="theme-option flex items-center gap-3 w-full px-4 py-3 text-sm text-gray-300 hover:bg-white/5 hover:text-white transition-colors">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            Clair
          </button>
          <button data-theme="system" class="theme-option flex items-center gap-3 w-full px-4 py-3 text-sm text-gray-300 hover:bg-white/5 hover:text-white transition-colors">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            Système
          </button>
        </div>
      </div>

      <a href="#templates" class="hidden md:flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-gray-900 bg-gradient-to-br from-[#00E5FF] to-[#80F2FF] rounded-lg hover:shadow-[0_0_20px_rgba(0,229,255,0.4)] transition-all">
        Voir les templates
      </a>
      
      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-400 hover:text-white" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div id="mobile-nav" class="hidden absolute top-[72px] left-0 right-0 bg-gray-950/95 backdrop-blur-xl border-b border-white/10 px-6 py-4 flex-col gap-2 md:hidden">
    {links.map((link) => (
      <a href={link.href} class="block px-4 py-3 text-sm font-medium text-gray-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
        {link.label}
      </a>
    ))}
    <a href="#templates" class="mt-2 block px-4 py-3 text-sm font-semibold text-center text-gray-900 bg-[#00E5FF] rounded-lg">
      Voir les templates
    </a>
  </div>
</header>

<script is:inline>
(function() {
  // ── ICONS ──
  const ICONS = {
    dark: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>',
    light: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>',
    system: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>'
  };
  const LABELS = { dark: 'Sombre', light: 'Clair', system: 'Système' };

  function resolveTheme(t) {
    if (t === 'system') return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    return t;
  }

  function applyTheme(theme) {
    const resolved = resolveTheme(theme);
    document.documentElement.classList.remove('dark', 'light');
    document.documentElement.classList.add(resolved);
    try { localStorage.setItem('kadrify_theme', theme); } catch(e) {}

    const icon = document.getElementById('theme-switcher-icon');
    const label = document.getElementById('theme-switcher-label');
    if (icon) icon.innerHTML = ICONS[theme] || ICONS.dark;
    if (label) label.textContent = LABELS[theme] || 'Sombre';

    // Update active state in dropdown
    document.querySelectorAll('.theme-option').forEach(btn => {
      btn.classList.toggle('text-[#00E5FF]', btn.dataset.theme === theme);
      btn.classList.toggle('font-semibold', btn.dataset.theme === theme);
    });
  }

  // Load saved theme
  let saved = 'dark';
  try { saved = localStorage.getItem('kadrify_theme') || 'dark'; } catch(e) {}
  applyTheme(saved);

  // System change listener
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    try { if (localStorage.getItem('kadrify_theme') === 'system') applyTheme('system'); } catch(e) {}
  });

  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('theme-switcher-btn');
    const dropdown = document.getElementById('theme-dropdown');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileNav = document.getElementById('mobile-nav');

    // Toggle dropdown
    btn && btn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('hidden');
    });

    // Close dropdown on outside click
    document.addEventListener('click', () => dropdown && dropdown.classList.add('hidden'));
    dropdown && dropdown.addEventListener('click', e => e.stopPropagation());

    // Theme options
    document.querySelectorAll('.theme-option').forEach(opt => {
      opt.addEventListener('click', () => {
        applyTheme(opt.dataset.theme);
        dropdown.classList.add('hidden');
      });
    });

    // Mobile menu toggle
    mobileBtn && mobileBtn.addEventListener('click', () => {
      mobileNav.classList.toggle('hidden');
      mobileNav.classList.toggle('flex');
    });
  });
})();
</script>
