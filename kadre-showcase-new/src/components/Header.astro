---
const links = [
  { href: "/#templates", label: "Templates" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 h-[72px] flex items-center justify-between px-6 transition-all duration-400 bg-gray-950/80 backdrop-blur-xl border-b border-white/10 shadow-lg">
  <div class="max-w-7xl w-full mx-auto flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 text-xl font-bold font-heading tracking-tight text-white hover:opacity-80 transition-opacity">
      <img src="/favicon.svg" alt="AuraKadre Logo" class="w-8 h-8 rounded-lg shadow-[0_0_15px_rgba(0,229,255,0.3)]" />
      AuraKadre<span class="text-[#00E5FF]">.</span>
    </a>
    
    <nav class="hidden md:flex items-center gap-2">
      {links.map((link) => (
        <a href={link.href} class="px-4 py-2 text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
          {link.label}
        </a>
      ))}
    </nav>
    
    <div class="flex items-center gap-3">
      <!-- Theme Switcher — Portfolio Style -->
      <div class="kadre-theme-switcher" id="theme-pill" role="group" aria-label="Thème">
        <div class="theme-active-indicator" id="tp-indicator"></div>
        <button class="theme-btn" data-theme="light" aria-label="Mode Clair" title="Clair">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        </button>
        <button class="theme-btn" data-theme="system" aria-label="Mode Système" title="Auto">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
        </button>
        <button class="theme-btn" data-theme="dark" aria-label="Mode Sombre" title="Sombre">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
      </div>

      <a href="/#templates" class="hidden md:flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-gray-900 bg-gradient-to-br from-[#00E5FF] to-[#80F2FF] rounded-lg hover:shadow-[0_0_20px_rgba(0,229,255,0.4)] transition-all">
        Voir les templates
      </a>
      
      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-400 hover:text-white" aria-label="Menu">
        <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        <svg id="close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div id="mobile-nav" class="hidden absolute top-[72px] left-0 right-0 bg-gray-950/95 backdrop-blur-xl border-b border-white/10 px-6 py-4 flex-col gap-2 md:hidden">
    <a href="/#templates" class="block px-4 py-3 text-sm font-medium text-gray-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">Templates</a>
    <a href="/#templates" class="mt-2 block px-4 py-3 text-sm font-semibold text-center text-gray-900 bg-[#00E5FF] rounded-lg">
      Voir les templates
    </a>
  </div>
</header>

<style>
/* ── THEME PILL ── */
.kadre-theme-switcher {
  position: relative;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(128, 128, 128, 0.15);
  border: 1px solid rgba(128, 128, 128, 0.2);
  padding: 0.25rem;
  border-radius: 2rem;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  flex-shrink: 0;
}
.theme-btn {
  position: relative;
  z-index: 2;
  background: transparent;
  border: none;
  color: rgba(255,255,255,0.4);
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: color 0.3s ease;
}
.theme-btn svg {
  width: 1.1rem;
  height: 1.1rem;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.theme-btn:hover { color: rgba(255,255,255,0.8); }
.theme-btn:hover svg { transform: scale(1.1); }
.theme-btn.active { color: #111; }

/* Sliding indicator */
.theme-active-indicator {
  position: absolute;
  top: 0.25rem;
  left: 0.25rem;
  width: 2.75rem;
  height: 2.75rem;
  background: #fff;
  border-radius: 50%;
  z-index: 1;
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  pointer-events: none;
}

/* Position: 0=light, 1=system, 2=dark */
.kadre-theme-switcher[data-active="light"] .theme-active-indicator { transform: translateX(0); }
.kadre-theme-switcher[data-active="system"] .theme-active-indicator { transform: translateX(calc(100% + 0.5rem)); }
.kadre-theme-switcher[data-active="dark"] .theme-active-indicator { transform: translateX(calc(200% + 1rem)); }

/* Light mode pill adaptation */
html.light .kadre-theme-switcher {
  background: rgba(15,23,42,0.06);
  border-color: rgba(15,23,42,0.12);
}
html.light .theme-btn { color: rgba(15,23,42,0.4); }
html.light .theme-btn:hover { color: rgba(15,23,42,0.8); }
html.light .theme-btn.active { color: #fff; }
html.light .theme-active-indicator {
  background: #0f172a;
}
</style>

<script is:inline>
(function() {
  const ORDER = ['light', 'system', 'dark'];

  function resolveTheme(t) {
    if (t === 'system') return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    return t;
  }

  function applyTheme(theme) {
    const resolved = resolveTheme(theme);
    document.documentElement.classList.remove('dark', 'light');
    document.documentElement.classList.add(resolved);
    try { localStorage.setItem('aurakadre_theme', theme); } catch(e) {}

    // Update pill state
    const pill = document.getElementById('theme-pill');
    if (pill) {
      pill.dataset.active = theme;
      pill.querySelectorAll('.theme-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.theme === theme);
      });
    }
  }

  // Load saved theme
  let saved = 'dark';
  try { saved = localStorage.getItem('aurakadre_theme') || 'dark'; } catch(e) {}
  applyTheme(saved);

  // System change listener
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    try { if (localStorage.getItem('aurakadre_theme') === 'system') applyTheme('system'); } catch(e) {}
  });

  document.addEventListener('DOMContentLoaded', () => {
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileNav = document.getElementById('mobile-nav');

    // Pill buttons
    document.querySelectorAll('.theme-btn').forEach(btn => {
      btn.addEventListener('click', () => applyTheme(btn.dataset.theme));
    });

    // Mobile menu toggle
    mobileBtn && mobileBtn.addEventListener('click', () => {
      mobileNav.classList.toggle('hidden');
      mobileNav.classList.toggle('flex');
      
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');
      if (menuIcon && closeIcon) {
        menuIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      }
    });

    // Close mobile menu on link click
    mobileNav && mobileNav.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        mobileNav.classList.remove('flex');
        
        const menuIcon = document.getElementById('menu-icon');
        const closeIcon = document.getElementById('close-icon');
        if (menuIcon && closeIcon) {
          menuIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        }
      });
    });
  });
})();
</script>
