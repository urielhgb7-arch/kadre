---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  schemaType?: 'website' | 'product';
  templateName?: string;
  templatePrice?: string;
}

const { 
  title, 
  description = "Trouve le template portfolio qui te ressemble. Pour développeurs, designers, photographes et créatifs. Personnalisable sans code, CMS intégré, prix accessible. Kadrify by Vouh Digital.",
  ogImage = "/og-image.png",
  canonical = Astro.url.href,
  schemaType = 'website',
  templateName,
  templatePrice
} = Astro.props;

const siteUrl = "https://kadre-blue.vercel.app";
const siteName = "Kadrify";
const fullTitle = title.includes('Kadrify') ? title : `${title} | Kadrify`;

// JSON-LD Schemas
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "url": siteUrl,
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/?s={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteName,
  "url": siteUrl,
  "logo": `${siteUrl}/logo.svg`,
  "sameAs": [],
  "description": "Plateforme de templates portfolio premium pour développeurs et créatifs. Personnalisation sans code avec CMS intégré."
};

const productSchema = templateName ? {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `Template ${templateName} — Kadrify`,
  "description": description,
  "image": `${siteUrl}${ogImage}`,
  "brand": { "@type": "Brand", "name": siteName },
  "offers": {
    "@type": "Offer",
    "price": "15500",
    "priceCurrency": "XAF",
    "availability": "https://schema.org/InStock",
    "url": canonical
  }
} : null;
---

<!doctype html>
<html lang="fr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- ── PRIMARY META ── -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="template portfolio premium, portfolio en ligne professionnel, portfolio sans code, CMS portfolio, créer son portfolio, portfolio freelance, portfolio designer, portfolio photographe, portfolio créatif, portfolio développeur, template web professionnel, kadrify, vouh digital" />
    <meta name="author" content="Vouh Digital" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="google-site-verification" content="7cwGmQxFSK4jgThbHFznzC9_PfKmxySo2cQAhx1CV-w" />
    <link rel="canonical" href={canonical} />
    
    <!-- ── OPEN GRAPH ── -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — Templates Portfolio Développeur`} />
    <meta property="og:locale" content="fr_FR" />
    
    <!-- ── TWITTER CARD ── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- ── FAVICONS ── -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <!-- ── PERFORMANCE ── -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- ── JSON-LD SCHEMAS ── -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {productSchema && <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />}
    
    <!-- ── 3D Background Scripts ── -->
    <script src="/js/three.min.js" is:inline></script>
    <script src="/js/webgl-ocean-network.js" is:inline defer></script>
    <script src="/js/liquid-orb.js" is:inline defer></script>
  </head>
  <body class="bg-gray-950 text-gray-100 font-sans antialiased min-h-screen flex flex-col relative selection:bg-indigo-500/30">
    <!-- LOADER -->
    <div id="kadre-loader" class="fixed inset-0 z-[99999] bg-[#060608] flex flex-col items-center justify-center transition-all duration-[800ms] ease-out">
      <canvas id="loader-canvas" width="600" height="200"></canvas>
      <div id="loader-brand" class="mt-5 font-heading font-semibold tracking-[4px] text-[0.72rem] uppercase text-white/50 min-h-[1.2em]"></div>
    </div>
    
    <script is:inline>
      (function(){
          if (sessionStorage.getItem('kadre-loaded')) {
              var el = document.getElementById('kadre-loader');
              if (el) { el.style.opacity='0'; el.style.visibility='hidden'; el.style.pointerEvents='none'; }
              return;
          }

          var loader = document.getElementById('kadre-loader');
          var canvas = document.getElementById('loader-canvas');
          if (!canvas || !loader) return;
          var ctx = canvas.getContext('2d');
          var W = canvas.width, H = canvas.height;

          var particlesDone = false;
          var brandDone = false;

          function tryDismiss() {
              if (particlesDone && brandDone) {
                  sessionStorage.setItem('kadre-loaded', '1');
                  loader.style.opacity = '0';
                  loader.style.visibility = 'hidden';
                  loader.style.pointerEvents = 'none';
              }
          }

          // Particle text "KADRIFY"
          var particles = [];
          var text = "KADRIFY";
          ctx.font = "bold 80px 'Space Grotesk', sans-serif";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillStyle = "#fff";
          ctx.fillText(text, W/2, H/2);

          var imageData = ctx.getImageData(0, 0, W, H);
          ctx.clearRect(0, 0, W, H);

          for (var y = 0; y < H; y += 3) {
              for (var x = 0; x < W; x += 3) {
                  var i = (y * W + x) * 4;
                  if (imageData.data[i+3] > 128) {
                      particles.push({
                          x: Math.random() * W,
                          y: Math.random() * H,
                          tx: x,
                          ty: y,
                          alpha: 0,
                          size: 1.2 + Math.random() * 1.2
                      });
                  }
              }
          }

          var t = 0;
          function draw() {
              // Liquid metal background for the loader
              var g = ctx.createRadialGradient(W/2, H/2, 0, W/2, H/2, W*0.6);
              g.addColorStop(0, 'rgba(40,38,45,1)');
              g.addColorStop(0.5, 'rgba(20,18,22,1)');
              g.addColorStop(1, 'rgba(6,6,8,1)');
              ctx.fillStyle = g;
              ctx.fillRect(0, 0, W, H);

              t += 0.04;
              var done = true;
              for (var i = 0; i < particles.length; i++) {
                  var p = particles[i];
                  var ease = 0.06 + t * 0.004;
                  p.x += (p.tx - p.x) * ease;
                  p.y += (p.ty - p.y) * ease;
                  p.alpha = Math.min(1, p.alpha + 0.03);
                  if (Math.abs(p.x - p.tx) > 0.5 || Math.abs(p.y - p.ty) > 0.5) done = false;
                  var gv = 180 + Math.floor(p.alpha * 75);
                  ctx.fillStyle = "rgba(" + (gv+30) + "," + (gv+20) + "," + (gv-30) + "," + p.alpha + ")";
                  ctx.fillRect(p.x, p.y, p.size, p.size);
              }
              if (!done) {
                  requestAnimationFrame(draw);
              } else {
                  particlesDone = true;
                  tryDismiss();
              }
          }
          draw();

          // "BY VOUH DIGITAL" letter by letter
          var brand = document.getElementById('loader-brand');
          var brandText = "BY VOUH DIGITAL";
          var brandIdx = 0;
          function typeBrand() {
              if (brandIdx <= brandText.length) {
                  brand.textContent = brandText.substring(0, brandIdx);
                  brandIdx++;
                  setTimeout(typeBrand, 30);
              } else {
                  brandDone = true;
                  tryDismiss();
              }
          }
          setTimeout(typeBrand, 300);

          // Fallback: force dismiss after 1.5s max
          setTimeout(function() {
              particlesDone = true;
              brandDone = true;
              tryDismiss();
          }, 1500);
      })();
    </script>

    <!-- WebGL 3D Background -->
    <canvas id="kadre-webgl" class="fixed inset-0 w-[100vw] h-[100vh] z-[-2] pointer-events-none"></canvas>

    <!-- Mesh Background / Noise overlay -->
    <div class="fixed inset-0 pointer-events-none z-[-1] opacity-30 mix-blend-screen">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_70%_10%,_hsla(189,100%,50%,0.12),_transparent)] will-change-transform"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_10%_80%,_hsla(271,91%,65%,0.08),_transparent)] will-change-transform"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_40%_40%_at_50%_50%,_hsla(200,100%,30%,0.08),_transparent)] will-change-transform"></div>
    </div>
    <div class="fixed inset-0 pointer-events-none z-[9999] opacity-[0.03] hidden md:block" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E&quot;);"></div>
    
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --accent: #00E5FF;
    --font-heading: 'Space Grotesk', sans-serif;
  }
  
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-family: 'Inter', sans-serif;
  }
  
  h1, h2, h3, h4, h5, h6, .font-heading {
    font-family: var(--font-heading);
  }

  /* Selection color */
  ::selection {
    background: rgba(0, 229, 255, 0.25);
    color: white;
  }

  /* Scrollbar styling */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: rgba(0, 229, 255, 0.3); border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: rgba(0, 229, 255, 0.5); }
</style>
