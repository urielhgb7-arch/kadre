---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  schemaType?: 'website' | 'product';
  templateName?: string;
  templatePrice?: string;
}

const { 
  title, 
  description = "Trouve le template portfolio qui te ressemble. Pour développeurs, designers, photographes et créatifs. Personnalisable sans code, CMS intégré, prix accessible. AuraKadre by Vouh Digital.",
  ogImage = "/og-image.png",
  canonical = Astro.url.href,
  schemaType = 'website',
  templateName,
  templatePrice
} = Astro.props;

const siteUrl = "https://aurakadre.com";
const siteName = "AuraKadre";
const fullTitle = title.includes('AuraKadre') ? title : `${title} | AuraKadre`;

// JSON-LD Schemas
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "url": siteUrl,
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/?s={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteName,
  "url": siteUrl,
  "logo": `${siteUrl}/logo.svg`,
  "sameAs": [],
  "description": "Plateforme de templates portfolio premium pour développeurs et créatifs. Personnalisation sans code avec CMS intégré."
};

const productSchema = templateName ? {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `Template ${templateName} — AuraKadre`,
  "description": description,
  "image": `${siteUrl}${ogImage}`,
  "brand": { "@type": "Brand", "name": siteName },
  "offers": {
    "@type": "Offer",
    "price": "15500",
    "priceCurrency": "XAF",
    "availability": "https://schema.org/InStock",
    "url": canonical
  }
} : null;

const navigationSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": [
    {
      "@type": "SiteNavigationElement",
      "position": 1,
      "name": "Templates",
      "url": `${siteUrl}/#templates`
    },
    {
      "@type": "SiteNavigationElement",
      "position": 2,
      "name": "Mentions Légales",
      "url": `${siteUrl}/mentions-legales`
    },
    {
      "@type": "SiteNavigationElement",
      "position": 3,
      "name": "Conditions Générales",
      "url": `${siteUrl}/cgv`
    }
  ]
};
---

<!doctype html>
<html lang="fr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- ── PRIMARY META ── -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="template portfolio premium, portfolio en ligne professionnel, portfolio sans code, CMS portfolio, créer son portfolio, portfolio freelance, portfolio designer, portfolio photographe, portfolio créatif, portfolio développeur, template web professionnel, aurakadre, vouh digital" />
    <meta name="author" content="Vouh Digital" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="google-site-verification" content="7cwGmQxFSK4jgThbHFznzC9_PfKmxySo2cQAhx1CV-w" />
    <link rel="canonical" href={canonical} />
    
    <!-- ── OPEN GRAPH ── -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — Templates Portfolio Développeur`} />
    <meta property="og:locale" content="fr_FR" />
    
    <!-- ── TWITTER CARD ── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- ── FAVICONS ── -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <!-- ── PERFORMANCE ── -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- ── JSON-LD SCHEMAS ── -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(navigationSchema)} />
    {productSchema && <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />}
    
    <!-- ── 3D Background Scripts ── -->
    <!-- is:inline = Astro garde le tag tel quel (ne tente pas de bundler public/) -->
    <script src="/js/three.min.js?v=3" is:inline></script>
    <script src="/js/webgl-ocean-network.js?v=3" is:inline defer></script>
    <script src="/js/liquid-orb.js?v=3" is:inline defer></script>
  </head>
  <body class="bg-gray-950 text-gray-100 font-sans antialiased min-h-screen flex flex-col relative selection:bg-indigo-500/30">
    <!-- LOADER -->
    <div id="kadre-loader" class="fixed inset-0 z-[99999] bg-[#060608] flex flex-col items-center justify-center transition-all duration-[800ms] ease-out">
      <div class="relative w-16 h-16 flex items-center justify-center mb-6">
        <div class="absolute inset-0 rounded-full border-t-2 border-[#00E5FF] animate-spin"></div>
        <div class="absolute inset-2 rounded-full border-r-2 border-[#80F2FF] animate-[spin_1.5s_linear_reverse_infinite]"></div>
        <div class="absolute inset-0 bg-[#00E5FF]/20 blur-xl rounded-full"></div>
      </div>
      <div class="font-heading font-bold text-xl tracking-[4px] text-white">AURAKADRE</div>
      <div class="mt-2 text-[0.65rem] tracking-[3px] text-gray-500 uppercase">by Vouh Digital</div>
    </div>
    
    <script is:inline>
      (function(){
          if (sessionStorage.getItem('kadre-loaded')) {
              var el = document.getElementById('kadre-loader');
              if (el) { el.style.opacity='0'; el.style.visibility='hidden'; el.style.pointerEvents='none'; }
              return;
          }
          
          window.addEventListener('load', function() {
              setTimeout(function() {
                  sessionStorage.setItem('kadre-loaded', '1');
                  var loader = document.getElementById('kadre-loader');
                  if (loader) {
                      loader.style.opacity = '0';
                      loader.style.visibility = 'hidden';
                      loader.style.pointerEvents = 'none';
                  }
              }, 800); // Délai fluide
          });
      })();
    </script>

    <!-- WebGL 3D Background -->
    <canvas id="kadre-webgl" class="fixed inset-0 w-[100vw] h-[100vh] z-[-2] pointer-events-none"></canvas>

    <!-- Mesh Background / Noise overlay -->
    <div class="fixed inset-0 pointer-events-none z-[-1] opacity-30 mix-blend-screen">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_70%_10%,_hsla(189,100%,50%,0.12),_transparent)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_10%_80%,_hsla(271,91%,65%,0.08),_transparent)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_40%_40%_at_50%_50%,_hsla(200,100%,30%,0.08),_transparent)]"></div>
    </div>
    <div class="fixed inset-0 pointer-events-none z-[9999] opacity-[0.03] hidden md:block" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E&quot;);"></div>
    
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --accent: #00E5FF;
    --font-heading: 'Space Grotesk', sans-serif;
  }
  
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-family: 'Inter', sans-serif;
  }
  
  h1, h2, h3, h4, h5, h6, .font-heading {
    font-family: var(--font-heading);
  }

  /* Selection color */
  ::selection {
    background: rgba(0, 229, 255, 0.25);
    color: white;
  }

  /* Scrollbar styling */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: rgba(0, 229, 255, 0.3); border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: rgba(0, 229, 255, 0.5); }
</style>
