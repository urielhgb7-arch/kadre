<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Previewer Kadrify — Sandbox Interactive</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
    <style is:global>
        :root {
            --bg-dark: #060608;
            --glass-bg: rgba(18, 18, 22, 0.85);
            --glass-border: rgba(255, 255, 255, 0.1);
            --accent: #00E5FF;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }
        /* THÈME CLAIR — activé par [data-theme="light"] sur <body> */
        body[data-theme="light"] {
            --bg-dark: #f4f6fb;
            --glass-bg: rgba(255, 255, 255, 0.82);
            --glass-border: rgba(15, 23, 42, 0.12);
            --accent: #00B3CC;
            --text-main: #0f172a;
            --text-muted: #64748b;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        /* TOP BAR */
        .sandbox-topbar {
            height: 60px;
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--glass-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            z-index: 100;
        }
        .left-controls {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .back-btn {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: color 0.2s;
        }
        .back-btn:hover { color: var(--text-main); }
        
        .device-controls {
            display: flex;
            background: rgba(0,0,0,0.5);
            border-radius: 8px;
            padding: 4px;
            border: 1px solid var(--glass-border);
        }
        body[data-theme="light"] .device-controls {
            background: rgba(15, 23, 42, 0.06);
        }
        .device-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.2s;
        }
        .device-btn.active {
            background: rgba(255,255,255,0.1);
            color: var(--text-main);
        }
        body[data-theme="light"] .device-btn.active {
            background: rgba(15, 23, 42, 0.08);
            color: var(--text-main);
        }
        .theme-toggle {
            background: transparent;
            border: 1px solid var(--glass-border);
            color: var(--text-muted);
            width: 36px;
            height: 36px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }
        .theme-toggle:hover {
            color: var(--text-main);
            border-color: var(--accent);
        }
        .buy-btn {
            background: var(--accent);
            color: #000;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: opacity 0.2s;
        }
        .buy-btn:hover { opacity: 0.9; }

        /* CUSTOMIZE BUTTON — glassmorphic, centered bottom, floats over preview */
        .customize-btn {
            position: fixed;
            left: 50%;
            bottom: 32px;
            transform: translateX(-50%);
            z-index: 300;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 28px;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(16px) saturate(160%);
            -webkit-backdrop-filter: blur(16px) saturate(160%);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-top: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow:
                0 16px 40px rgba(0, 0, 0, 0.5),
                inset 0 1px 0 rgba(255, 255, 255, 0.25),
                inset 0 -1px 0 rgba(0, 0, 0, 0.2);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        /* Variante thème clair */
        body[data-theme="light"] .customize-btn {
            background: rgba(255, 255, 255, 0.72);
            border: 1px solid rgba(15, 23, 42, 0.18);
            border-top: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow:
                0 16px 40px rgba(15, 23, 42, 0.18),
                inset 0 1px 0 rgba(255, 255, 255, 0.8),
                inset 0 -1px 0 rgba(15, 23, 42, 0.08);
            color: var(--text-main);
        }
        .customize-btn:hover {
            background: rgba(255, 255, 255, 0.14);
            border-color: var(--accent);
            transform: translateX(-50%) translateY(-2px);
            box-shadow:
                0 24px 48px rgba(0, 0, 0, 0.6),
                0 0 24px rgba(212, 166, 86, 0.25),
                inset 0 1px 0 rgba(255, 255, 255, 0.3);
        }
        body[data-theme="light"] .customize-btn:hover {
            background: rgba(255, 255, 255, 0.9);
            border-color: var(--accent);
            box-shadow:
                0 24px 48px rgba(15, 23, 42, 0.22),
                0 0 24px rgba(176, 125, 31, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.95);
        }
        .customize-btn svg { flex-shrink: 0; }
        .customize-btn .pulse-dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: #34d399;
            box-shadow: 0 0 8px #34d399;
            animation: dotPulse 1.8s ease-in-out infinite;
        }
        @keyframes dotPulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.75); }
        }

        /* IFRAME WRAPPER */
        .iframe-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #000;
            padding: 20px;
            transition: padding 0.3s;
        }
        body[data-theme="light"] .iframe-container { background: #e8ecf4; }
        .iframe-wrapper {
            width: 100%;
            height: 100%;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--glass-border);
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
        }
        .iframe-wrapper iframe {
            width: 100%;
            height: 100%;
            border: none;
            background: #fff;
        }

        /* DEVICE SIZES */
        .iframe-wrapper.desktop {
            width: 100%;
            max-width: 1440px;
        }
        .iframe-wrapper.tablet {
            width: 768px;
            height: 1024px;
            max-height: 100%;
        }
        .iframe-wrapper.mobile {
            width: 375px;
            height: 812px;
            max-height: 100%;
            border-radius: 30px;
            border: 8px solid #222;
        }
        @media (max-width: 768px) {
            .iframe-container { padding: 12px; }
            .iframe-wrapper.mobile { width: 320px; height: 700px; }
            .iframe-wrapper.tablet { width: 100%; max-width: 700px; }
        }
        @media (max-width: 380px) {
            .iframe-wrapper.mobile { width: 100%; height: 80vh; border: 4px solid #222; }
        }

        /* TOOLTIP UX */
        .ux-tooltip {
            position: absolute;
            bottom: 40px;
            right: 40px;
            background: rgba(139, 92, 246, 0.9);
            color: #fff;
            padding: 12px 20px;
            border-radius: 12px;
            font-size: 0.9rem;
            box-shadow: 0 10px 25px rgba(139, 92, 246, 0.4);
            animation: bounce 2s infinite, fadeInOut 15s forwards;
            pointer-events: none;
            z-index: 200;
        }
        .ux-tooltip::before {
            content: '✨';
            margin-right: 8px;
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        @keyframes fadeInOut {
            0% { opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { opacity: 0; }
        }

        /* ── RESPONSIVE SANDBOX ── */
        @media (max-width: 768px) {
            .sandbox-topbar {
                height: 56px;
                padding: 0 12px;
                gap: 8px;
            }
            .left-controls { gap: 8px; }
            .left-controls img { display: none; }
            .device-btn { padding: 6px 8px; font-size: 0.78rem; }
            .customize-btn {
                bottom: 20px;
                padding: 12px 22px;
                font-size: 0.88rem;
            }
            .ux-tooltip {
                bottom: 84px;
                right: 16px;
                left: 16px;
                text-align: center;
                font-size: 0.82rem;
            }
        }
        @media (max-width: 480px) {
            .device-controls { padding: 3px; }
            .device-btn { padding: 5px 6px; font-size: 0.7rem; }
            .buy-btn { padding: 7px 12px; font-size: 0.8rem; }
            .theme-toggle { width: 32px; height: 32px; }
            .customize-btn { gap: 8px; }
        }
        @media (max-width: 360px) {
            .sandbox-topbar { padding: 0 8px; gap: 4px; }
            .back-btn svg { width: 18px; height: 18px; }
            .device-btn { padding: 5px 4px; font-size: 0.65rem; }
            .buy-btn { padding: 6px 10px; font-size: 0.75rem; }
            .customize-btn { bottom: 14px; padding: 11px 18px; font-size: 0.84rem; }
        }
    </style>
</head>
<body>
    <div class="sandbox-topbar">
        <div class="left-controls">
            <a href="index.html" class="back-btn" title="Retour">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            </a>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" style="margin-left:12px; border-left: 1px solid rgba(255,255,255,0.1); padding-left:12px; width: 36px;"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 7v10M15 7l-6 5 6 5"/></svg>
        </div>
        <div class="device-controls">
            <button class="device-btn active" data-device="desktop">Desktop</button>
            <button class="device-btn" data-device="tablet">Tablette</button>
            <button class="device-btn" data-device="mobile">Mobile</button>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
            <button class="theme-toggle" id="theme-toggle" title="Basculer le thème">
                <svg id="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </button>
            <a href="#" id="buy-btn" target="_blank" class="buy-btn">Acheter — 15 500 XAF</a>
        </div>
    </div>

    <div class="iframe-container" style="position:relative;">
        <div class="iframe-wrapper desktop" id="preview-wrapper">
            <iframe id="preview-frame" src=""></iframe>
        </div>
        <button class="customize-btn" id="customize-btn" title="Personnaliser le contenu (comme le triple-clic)">
            <span class="pulse-dot"></span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            Personnaliser
        </button>
    </div>
    
    <div class="ux-tooltip">Cliquez sur <b>"Personnaliser"</b> en bas pour modifier le contenu !</div>

    <script>
        // Lecture du template depuis l'URL (nouveau format ?template= ou ancien format ?t=)
        const params = new URLSearchParams(window.location.search);
        let templateId = params.get('template'); // format: "01-terminal-craft"
        
        if (!templateId) {
            // Rétrocompatibilité avec l'ancien format ?t=template-01-terminal-craft.html
            const legacyT = params.get('t') || 'template-01-terminal-craft.html';
            templateId = legacyT.replace('template-', '').replace('.html', '');
        }
        
        // Checkout dynamique
        const checkoutSlug = templateId.replace(/^\d{2}-/, '');
        document.getElementById('buy-btn').href = `https://huvo-shop.mymaketou.shop/products/${checkoutSlug}/checkout`;
        
        // Charger l'URL réelle avec ?sandbox=true
        const frame = document.getElementById('preview-frame');
        frame.src = `/templates/${templateId}/index.html?sandbox=true`;

        // Gestion des devices
        const wrapper = document.getElementById('preview-wrapper');
        document.querySelectorAll('.device-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('.device-btn').forEach(b => b.classList.remove('active'));
                e.target.classList.add('active');
                
                const device = e.target.dataset.device;
                wrapper.className = 'iframe-wrapper ' + device;
            });
        });

        // Bouton "Personnaliser" → déclenche le CMS dans l'iframe
        // (même action que le triple-clic, désactivé en sandbox)
        document.getElementById('customize-btn').addEventListener('click', () => {
            const iframe = document.getElementById('preview-frame');
            if (iframe && iframe.contentWindow) {
                try { iframe.contentWindow.focus(); } catch(e) {}
                iframe.contentWindow.postMessage({ type: 'kadre-open-admin' }, '*');
            }
        });

        // La sandbox s'active dans la fenêtre active : focus sur l'iframe au chargement
        frame.addEventListener('load', () => {
            try { frame.focus(); } catch(e) {}
        });
        document.body.addEventListener('click', (e) => {
            if (e.target && e.target !== frame && !e.target.closest('.customize-btn')) {
                try { frame.focus(); } catch(e) {}
            }
        });

        // Thème sombre/clair — le bouton Personnaliser suit via les variables CSS
        const themeToggle = document.getElementById('theme-toggle');
        const themeIcon = document.getElementById('theme-icon');
        const MOON = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
        const SUN = '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';

        const SYSTEM = '<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>';

        function applyTheme(theme) {
            let activeTheme = theme;
            if (theme === 'system') {
                activeTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            
            document.body.setAttribute('data-theme', activeTheme);
            
            if (theme === 'light') themeIcon.innerHTML = MOON;
            else if (theme === 'dark') themeIcon.innerHTML = SYSTEM;
            else themeIcon.innerHTML = SUN;
            
            try { localStorage.setItem('kadre_sandbox_theme', theme); } catch(e) {}
            
            // Sync with iframe
            const iframe = document.getElementById('preview-frame');
            if (iframe && iframe.contentWindow) {
                iframe.contentWindow.postMessage({ type: 'KADRE_THEME_CHANGE', theme: theme }, '*');
            }
        }
        
        // Listen to system changes
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
            if (localStorage.getItem('kadre_sandbox_theme') === 'system') {
                applyTheme('system');
            }
        });
        
        // Also send initial theme when iframe loads
        const previewFrame = document.getElementById('preview-frame');
        previewFrame.addEventListener('load', () => {
            let currentTheme = 'dark';
            try { currentTheme = localStorage.getItem('kadre_sandbox_theme') || 'dark'; } catch(e) {}
            if (previewFrame && previewFrame.contentWindow) {
                previewFrame.contentWindow.postMessage({ type: 'KADRE_THEME_CHANGE', theme: currentTheme }, '*');
            }
        });

        let savedTheme = 'dark';
        try { savedTheme = localStorage.getItem('kadre_sandbox_theme') || 'dark'; } catch(e) {}
        applyTheme(savedTheme);

        themeToggle.addEventListener('click', () => {
            let current = 'dark';
            try { current = localStorage.getItem('kadre_sandbox_theme') || 'dark'; } catch(e) {}
            
            let next = 'light';
            if (current === 'light') next = 'dark';
            else if (current === 'dark') next = 'system';
            
            applyTheme(next);
        });
    </script>
</body>
</html>
