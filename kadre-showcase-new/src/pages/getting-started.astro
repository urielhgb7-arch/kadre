---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Guide d'Utilisation | Kadrify" description="Prise en main de votre nouveau template Kadrify.">
  <main class="relative min-h-[100dvh] w-full flex flex-col items-center justify-start pt-24 pb-32 px-4 sm:px-8 overflow-hidden selection:bg-[#00E5FF]/30 selection:text-white">
    
    <!-- Immersive Background Layer (Local to this page) -->
    <div class="absolute inset-0 pointer-events-none z-[-1] overflow-hidden mix-blend-screen">
      <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-[radial-gradient(ellipse_at_center,_hsla(189,100%,50%,0.15)_0%,_transparent_70%)] blur-[80px] animate-pulse-slow"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[60%] h-[60%] rounded-full bg-[radial-gradient(ellipse_at_center,_hsla(271,91%,65%,0.1)_0%,_transparent_70%)] blur-[100px]"></div>
    </div>

    <!-- Container -->
    <div class="w-full max-w-5xl mx-auto flex flex-col items-center z-10">
      
      <!-- HERO SECTION -->
      <header class="text-center w-full max-w-3xl mb-24 fade-in-up">
        <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-white/[0.03] border border-white/[0.08] shadow-[0_4px_24px_rgba(0,0,0,0.2)] backdrop-blur-md mb-8">
          <span class="w-2 h-2 rounded-full bg-[#00E5FF] shadow-[0_0_8px_#00E5FF] animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#00E5FF]">Bienvenue sur Kadrify</span>
        </div>
        
        <h1 class="font-heading font-bold text-transparent bg-clip-text bg-gradient-to-b from-white via-white to-white/60 tracking-tighter leading-[1.1] mb-6" style="font-size: clamp(3rem, 8vw + 1rem, 5.5rem);">
          Félicitations pour <br class="hidden sm:block" />votre acquisition.
        </h1>
        
        <p class="text-gray-400 text-lg sm:text-xl leading-relaxed max-w-2xl mx-auto mb-10" style="font-size: clamp(1rem, 1.5vw, 1.125rem);">
          Votre espace portfolio premium est prêt. Suivez ce guide interactif pour personnaliser, prévisualiser et publier votre site en quelques minutes, sans toucher à une ligne de code.
        </p>

        <a href="/" class="group relative inline-flex items-center gap-3 px-8 py-4 font-semibold text-[#00E5FF] bg-transparent border border-[#00E5FF]/30 rounded-2xl overflow-hidden transition-all duration-300 hover:scale-[0.98] hover:shadow-[0_0_30px_rgba(0,229,255,0.15)]">
          <span class="absolute inset-0 bg-[#00E5FF]/10 translate-y-[100%] group-hover:translate-y-0 transition-transform duration-300 ease-out"></span>
          <span class="relative z-10">Retourner à l'accueil</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="relative z-10 group-hover:-translate-x-1 transition-transform"><path d="m15 18-6-6 6-6"/></svg>
        </a>
      </header>

      <!-- BENTO GRID STEPS -->
      <section class="w-full grid grid-cols-1 md:grid-cols-12 gap-6">
        
        <!-- STEP 1 : Wide Card -->
        <article class="scroll-reveal md:col-span-12 group relative flex flex-col md:flex-row items-center gap-8 p-8 sm:p-12 rounded-[2.5rem] bg-gray-900/40 border border-white/10 backdrop-blur-2xl shadow-[0_20px_60px_-15px_rgba(0,0,0,0.5)] overflow-hidden hover:border-white/20 transition-colors duration-500">
          <div class="absolute inset-0 bg-gradient-to-br from-white/[0.02] to-transparent pointer-events-none"></div>
          
          <div class="flex-1 space-y-6 relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-[#00E5FF]/10 border border-[#00E5FF]/20 flex items-center justify-center text-[#00E5FF] font-heading font-bold text-xl shadow-[0_0_20px_rgba(0,229,255,0.1)]">
              01
            </div>
            <h2 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-white">Lancement de la Sandbox</h2>
            <p class="text-gray-400 leading-relaxed max-w-lg">
              Une fois votre fichier téléchargé, décompressez l'archive. Ouvrez le dossier dans <strong>VS Code</strong> et lancez simplement le serveur local pour accéder à la Sandbox interactive Kadrify. 
            </p>
            <div class="inline-block p-4 rounded-xl bg-black/50 border border-white/5 font-mono text-sm text-[#00E5FF]">
              <span class="text-gray-500">~</span> npm install<br/>
              <span class="text-gray-500">~</span> npm run dev
            </div>
          </div>
          
          <!-- Abstract Illustration -->
          <div class="w-full md:w-[45%] aspect-square md:aspect-[4/3] rounded-3xl bg-black/50 border border-white/5 relative overflow-hidden flex items-center justify-center">
             <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_hsla(189,100%,50%,0.2)_0%,_transparent_70%)] opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
             <!-- Animated Code Blocks -->
             <div class="flex flex-col gap-3 w-3/4 transform group-hover:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
               <div class="h-6 w-full rounded-md bg-white/10 overflow-hidden relative"><div class="absolute top-0 left-0 h-full bg-[#00E5FF] w-1/3 animate-shimmer"></div></div>
               <div class="h-6 w-3/4 rounded-md bg-white/5"></div>
               <div class="h-6 w-5/6 rounded-md bg-white/5"></div>
             </div>
          </div>
        </article>

        <!-- STEP 2 : Tall Card Left -->
        <article class="scroll-reveal md:col-span-5 group relative flex flex-col p-8 sm:p-10 rounded-[2.5rem] bg-gray-900/40 border border-white/10 backdrop-blur-2xl shadow-[0_20px_60px_-15px_rgba(0,0,0,0.5)] hover:border-[#00E5FF]/30 transition-colors duration-500">
          <div class="w-14 h-14 rounded-2xl bg-[#00E5FF]/10 border border-[#00E5FF]/20 flex items-center justify-center text-[#00E5FF] font-heading font-bold text-xl mb-8">
            02
          </div>
          <h2 class="font-heading text-2xl font-bold tracking-tight text-white mb-4">Édition du Contenu</h2>
          <p class="text-gray-400 leading-relaxed flex-1">
            Utilisez notre panneau d'administration invisible (triple-clic sur le logo). Vous pouvez y modifier vos textes, vos images, vos couleurs et vos liens sociaux en temps réel, avec une sauvegarde automatique.
          </p>
          
          <!-- UI Illustration -->
          <div class="mt-8 w-full aspect-video rounded-2xl border border-white/10 bg-black/60 relative overflow-hidden flex flex-col p-4 gap-3">
             <div class="flex items-center gap-2 mb-2">
               <div class="w-3 h-3 rounded-full bg-red-500/50"></div>
               <div class="w-3 h-3 rounded-full bg-yellow-500/50"></div>
               <div class="w-3 h-3 rounded-full bg-green-500/50"></div>
             </div>
             <div class="w-1/2 h-2 rounded bg-white/20"></div>
             <div class="w-full h-2 rounded bg-white/10"></div>
             <div class="w-3/4 h-2 rounded bg-white/10"></div>
             <!-- Floating edit button -->
             <div class="absolute bottom-4 right-4 w-8 h-8 rounded-full bg-[#00E5FF] flex items-center justify-center shadow-[0_0_15px_#00E5FF] group-hover:scale-110 transition-transform">
               <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
             </div>
          </div>
        </article>

        <!-- STEP 3 : Tall Card Right -->
        <article class="scroll-reveal md:col-span-7 group relative flex flex-col p-8 sm:p-10 rounded-[2.5rem] bg-gray-900/40 border border-white/10 backdrop-blur-2xl shadow-[0_20px_60px_-15px_rgba(0,0,0,0.5)] hover:border-white/20 transition-colors duration-500">
          <div class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-white font-heading font-bold text-xl mb-8">
            03
          </div>
          <h2 class="font-heading text-2xl font-bold tracking-tight text-white mb-4">Déploiement Vercel / Netlify</h2>
          <p class="text-gray-400 leading-relaxed">
            Votre portfolio est optimisé pour un déploiement instantané. Poussez votre code sur GitHub, connectez votre dépôt à Vercel ou Netlify, et votre site sera en ligne avec des performances parfaites (Score Lighthouse 100).
          </p>
          
          <!-- Deployment Illustration -->
          <div class="mt-8 flex-1 w-full rounded-2xl border border-white/10 bg-black/60 relative overflow-hidden p-6 flex flex-col justify-center items-center group-hover:border-green-500/30 transition-colors duration-500">
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_hsla(120,100%,50%,0.05)_0%,_transparent_70%)]"></div>
            
            <div class="flex items-center gap-6">
              <div class="w-16 h-16 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.45-1.15-1.11-1.46-1.11-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/></svg>
              </div>
              <div class="h-[2px] w-12 bg-gradient-to-r from-white/10 via-white/40 to-white/10 relative">
                <div class="absolute inset-0 bg-[#00E5FF] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-700 delay-100"></div>
              </div>
              <div class="w-16 h-16 rounded-2xl bg-white flex items-center justify-center transform group-hover:-translate-y-2 transition-transform duration-500 delay-200 shadow-[0_0_30px_rgba(255,255,255,0.1)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="black"><path d="M24 22.525H0l12-21.05 12 21.05z"/></svg>
              </div>
            </div>
            <div class="mt-6 px-4 py-1.5 rounded-full bg-green-500/10 border border-green-500/20 text-green-400 text-xs font-mono font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-500">
              ✓ Production Deployment Ready
            </div>
          </div>
        </article>
      </section>

      <!-- BOTTOM CTA -->
      <footer class="mt-32 mb-16 text-center scroll-reveal">
        <h3 class="font-heading text-2xl font-bold text-white mb-6">Prêt à créer votre portfolio ?</h3>
        <a href="/" class="group relative inline-flex items-center gap-3 px-10 py-5 font-bold text-gray-900 bg-[#00E5FF] rounded-2xl overflow-hidden transition-all duration-300 hover:scale-[0.98] shadow-[0_0_40px_rgba(0,229,255,0.3)]">
          <span class="absolute inset-0 bg-white/20 translate-y-[100%] group-hover:translate-y-0 transition-transform duration-300 ease-out"></span>
          <span class="relative z-10">Ouvrir l'Espace Personnel</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="relative z-10 group-hover:translate-x-1 transition-transform"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </footer>

    </div>
  </main>
</Layout>

<style>
  /* Base Entrance Animation for Hero */
  .fade-in-up {
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Shimmer effect for code illustration */
  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(300%); }
  }
  .animate-shimmer {
    animation: shimmer 2s infinite ease-in-out;
  }

  /* Pulse Slow for background mesh */
  @keyframes pulseSlow {
    0%, 100% { opacity: 0.8; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.1); }
  }
  .animate-pulse-slow {
    animation: pulseSlow 8s ease-in-out infinite;
  }

  /* Scroll-driven animations (CSS view-timeline) */
  @supports (animation-timeline: view()) {
    .scroll-reveal {
      opacity: 0;
      animation: revealCard linear both;
      animation-timeline: view();
      /* Starts animating when element enters 5% of viewport, ends when it reaches 25% */
      animation-range: entry 5% cover 25%;
    }

    @keyframes revealCard {
      0% {
        opacity: 0;
        transform: translateY(60px) scale(0.95);
        filter: blur(10px);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0px);
      }
    }
  }

  /* Fallback for browsers that do not support view-timeline (e.g. Safari) */
  @supports not (animation-timeline: view()) {
    .scroll-reveal {
      opacity: 1;
      transform: none;
    }
  }
</style>
