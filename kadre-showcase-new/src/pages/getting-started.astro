---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Guide d'Utilisation | Kadrify" description="Prise en main de votre nouveau template Kadrify.">
  <main class="relative min-h-[100dvh] w-full flex flex-col items-center justify-start pt-24 pb-32 px-4 sm:px-8 overflow-hidden selection:bg-[#00E5FF]/30 selection:text-white" style="perspective: 1500px;">
    
    <!-- Immersive Background Layer (Local to this page) -->
    <div class="absolute inset-0 pointer-events-none z-[-1] overflow-hidden mix-blend-screen">
      <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-[radial-gradient(ellipse_at_center,_hsla(189,100%,50%,0.2)_0%,_transparent_70%)] blur-[80px] animate-pulse-slow"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[60%] h-[60%] rounded-full bg-[radial-gradient(ellipse_at_center,_hsla(271,91%,65%,0.15)_0%,_transparent_70%)] blur-[100px]"></div>
    </div>

    <!-- Container -->
    <div class="w-full max-w-5xl mx-auto flex flex-col items-center z-10 transform-style-3d">
      
      <!-- HERO SECTION -->
      <header class="text-center w-full max-w-3xl mb-32 fade-in-up">
        <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-white/[0.03] border border-white/[0.08] shadow-[0_4px_24px_rgba(0,0,0,0.2)] backdrop-blur-md mb-8">
          <span class="w-2 h-2 rounded-full bg-[#00E5FF] shadow-[0_0_8px_#00E5FF] animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#00E5FF]">Configuration Initiale</span>
        </div>
        
        <h1 class="font-heading font-bold text-transparent bg-clip-text bg-gradient-to-b from-white via-white to-white/60 tracking-tighter leading-[1.1] mb-6" style="font-size: clamp(3rem, 8vw + 1rem, 5.5rem);">
          Lancez votre <br class="hidden sm:block" />nouveau portfolio.
        </h1>
        
        <p class="text-gray-400 text-lg sm:text-xl leading-relaxed max-w-2xl mx-auto mb-10" style="font-size: clamp(1rem, 1.5vw, 1.125rem);">
          Félicitations pour votre achat ! Plus besoin de toucher au code ou de lire des fichiers techniques. Suivez ces trois étapes interactives pour sécuriser, modifier et déployer votre site.
        </p>

        <a href="/" class="group relative inline-flex items-center gap-3 px-8 py-4 font-semibold text-[#00E5FF] bg-transparent border border-[#00E5FF]/30 rounded-2xl overflow-hidden transition-all duration-300 hover:scale-[0.98] hover:shadow-[0_0_30px_rgba(0,229,255,0.15)]">
          <span class="absolute inset-0 bg-[#00E5FF]/10 translate-y-[100%] group-hover:translate-y-0 transition-transform duration-300 ease-out"></span>
          <span class="relative z-10">Retourner à l'accueil</span>
        </a>
      </header>

      <!-- BENTO GRID STEPS - 3D SCROLL EXPERIENCE -->
      <section class="w-full flex flex-col gap-12 sm:gap-24 perspective-container">
        
        <!-- STEP 1 : Base de données (Supabase) -->
        <article class="scroll-3d-emerge w-full group relative flex flex-col md:flex-row items-center gap-8 p-8 sm:p-12 rounded-[2.5rem] bg-gray-900/40 border border-white/10 backdrop-blur-3xl shadow-[0_30px_80px_-20px_rgba(0,0,0,0.6)] overflow-hidden hover:border-[#00E5FF]/40 transition-colors duration-500">
          <div class="absolute inset-0 bg-gradient-to-br from-[#00E5FF]/[0.03] to-transparent pointer-events-none"></div>
          
          <div class="flex-1 space-y-6 relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-[#00E5FF]/10 border border-[#00E5FF]/20 flex items-center justify-center text-[#00E5FF] font-heading font-bold text-xl shadow-[0_0_20px_rgba(0,229,255,0.1)]">
              01
            </div>
            <h2 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-white">Clés de Sécurité (Supabase)</h2>
            <p class="text-gray-400 leading-relaxed max-w-lg text-lg">
              Votre site utilise une base de données ultra-sécurisée. Créez un compte gratuit sur <strong>Supabase.com</strong>, créez un projet, puis allez dans les paramètres (⚙️) > API pour copier ces deux clés :
            </p>
            <ul class="space-y-4 mt-6">
              <li class="flex items-start gap-4">
                <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center mt-1 border border-white/10 shrink-0">🔗</div>
                <div>
                  <strong class="text-white block mb-1">Project URL</strong>
                  <span class="text-sm text-gray-500 block">L'URL de votre base de données (ex: https://xxx.supabase.co).</span>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center mt-1 border border-white/10 shrink-0">🔑</div>
                <div>
                  <strong class="text-white block mb-1">Anon Public Key</strong>
                  <span class="text-sm text-gray-500 block">La clé publique (commence par `eyJ...`). Elle sécurise l'accès à vos données depuis le site.</span>
                </div>
              </li>
            </ul>
          </div>
          
          <!-- 3D UI Illustration -->
          <div class="w-full md:w-[45%] aspect-square rounded-3xl bg-[#060608]/80 border border-white/5 relative overflow-hidden flex items-center justify-center group-hover:shadow-[0_0_50px_rgba(0,229,255,0.1)] transition-shadow duration-700">
             <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_hsla(189,100%,50%,0.1)_0%,_transparent_70%)] opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
             
             <!-- Floating Key Cards -->
             <div class="relative w-full h-full flex items-center justify-center perspective-inner">
               <div class="absolute w-2/3 p-4 rounded-xl bg-white/5 border border-white/10 backdrop-blur-md transform -translate-y-8 -translate-z-10 rotate-x-12 group-hover:translate-y-[-40px] group-hover:rotate-x-0 transition-transform duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
                 <div class="text-xs text-gray-500 mb-2">Project URL</div>
                 <div class="h-2 w-full rounded-full bg-white/10 overflow-hidden"><div class="h-full bg-green-400 w-full opacity-50"></div></div>
               </div>
               
               <div class="absolute w-3/4 p-4 rounded-xl bg-gray-900 border border-[#00E5FF]/30 backdrop-blur-md transform translate-y-8 translate-z-10 rotate-x-[-10deg] shadow-[0_20px_40px_rgba(0,0,0,0.8)] group-hover:translate-y-[30px] group-hover:rotate-x-0 transition-transform duration-700 delay-75 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
                 <div class="flex items-center gap-2 mb-3">
                   <div class="w-2 h-2 rounded-full bg-[#00E5FF] animate-pulse"></div>
                   <div class="text-xs text-[#00E5FF] font-mono">anon public</div>
                 </div>
                 <div class="font-mono text-xs text-gray-400 break-all leading-relaxed">
                   eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
                 </div>
               </div>
             </div>
          </div>
        </article>

        <!-- STEP 2 : L'Assistant Magique -->
        <article class="scroll-3d-emerge w-full group relative flex flex-col md:flex-row-reverse items-center gap-8 p-8 sm:p-12 rounded-[2.5rem] bg-gray-900/40 border border-white/10 backdrop-blur-3xl shadow-[0_30px_80px_-20px_rgba(0,0,0,0.6)] hover:border-purple-500/30 transition-colors duration-500">
          <div class="absolute inset-0 bg-gradient-to-bl from-purple-500/[0.03] to-transparent pointer-events-none"></div>
          
          <div class="flex-1 space-y-6 relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-heading font-bold text-xl shadow-[0_0_20px_rgba(168,85,247,0.1)]">
              02
            </div>
            <h2 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-white">L'Assistant Magique (Édition)</h2>
            <p class="text-gray-400 leading-relaxed text-lg">
              Une fois votre site ouvert dans le navigateur (en local ou en ligne), effectuez un <strong>triple clic rapide</strong> sur votre logo en haut à gauche.
            </p>
            <div class="p-6 rounded-2xl bg-black/40 border border-white/5 relative overflow-hidden">
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-purple-500 to-[#00E5FF]"></div>
              <p class="text-sm text-gray-300 leading-relaxed">
                Ce geste secret ouvre le panneau de configuration. Collez vos clés Supabase, définissez un mot de passe Admin, et vous pourrez modifier tous vos textes, images et couleurs en direct, sans toucher au code.
              </p>
            </div>
          </div>
          
          <!-- UI Magic Illustration -->
          <div class="w-full md:w-[45%] aspect-square rounded-3xl border border-white/10 bg-black/60 relative overflow-hidden flex items-center justify-center perspective-inner">
             
             <!-- Fake Website Header -->
             <div class="absolute top-10 left-1/2 -translate-x-1/2 w-3/4 h-16 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm flex items-center px-6 justify-between group-hover:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
                <!-- Logo Target -->
                <div class="relative w-10 h-10 rounded-full bg-white/10 border border-white/20 flex items-center justify-center cursor-pointer group-hover:border-purple-400 transition-colors">
                  <div class="w-2 h-2 rounded-full bg-purple-400"></div>
                  <!-- Click Ripples -->
                  <div class="absolute inset-0 rounded-full border border-purple-400 opacity-0 group-hover:animate-ripple"></div>
                  <div class="absolute inset-0 rounded-full border border-purple-400 opacity-0 group-hover:animate-ripple" style="animation-delay: 200ms;"></div>
                  <div class="absolute inset-0 rounded-full border border-purple-400 opacity-0 group-hover:animate-ripple" style="animation-delay: 400ms;"></div>
                </div>
                <div class="flex gap-3">
                  <div class="w-12 h-2 rounded-full bg-white/10"></div>
                  <div class="w-12 h-2 rounded-full bg-white/10"></div>
                </div>
             </div>

             <!-- Secret Panel Slide Up -->
             <div class="absolute bottom-[-20%] left-1/2 -translate-x-1/2 w-2/3 h-1/2 rounded-t-3xl bg-gray-900 border-t border-x border-purple-500/30 shadow-[0_-20px_50px_rgba(168,85,247,0.2)] flex flex-col p-6 gap-4 transform group-hover:bottom-0 transition-all duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
                <div class="w-1/3 h-3 rounded bg-white/20 mb-2"></div>
                <div class="w-full h-8 rounded-lg bg-black/50 border border-white/10"></div>
                <div class="w-full h-8 rounded-lg bg-black/50 border border-white/10"></div>
                <div class="w-full h-10 rounded-lg bg-purple-600/80 mt-auto"></div>
             </div>
          </div>
        </article>

        <!-- STEP 3 : Déploiement -->
        <article class="scroll-3d-emerge w-full group relative flex flex-col md:flex-row items-center gap-8 p-8 sm:p-12 rounded-[2.5rem] bg-gray-900/40 border border-white/10 backdrop-blur-3xl shadow-[0_30px_80px_-20px_rgba(0,0,0,0.6)] hover:border-green-500/30 transition-colors duration-500">
          
          <div class="flex-1 space-y-6 relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-white font-heading font-bold text-xl shadow-[0_0_20px_rgba(255,255,255,0.05)]">
              03
            </div>
            <h2 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-white">Déploiement en 1 Clic</h2>
            <p class="text-gray-400 leading-relaxed text-lg">
              Votre portfolio est construit en HTML/CSS/JS natif, ce qui le rend compatible avec n'importe quel hébergeur moderne.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
              <div class="p-5 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors">
                <h4 class="text-white font-bold mb-2">▲ Vercel</h4>
                <p class="text-sm text-gray-400">Glissez-déposez simplement le dossier de votre template sur Vercel.com</p>
              </div>
              <div class="p-5 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors">
                <h4 class="text-white font-bold mb-2">❖ Netlify</h4>
                <p class="text-sm text-gray-400">Hébergement ultra-rapide gratuit. Même principe : Drag & Drop.</p>
              </div>
            </div>
          </div>
          
          <!-- Deployment Illustration -->
          <div class="w-full md:w-[45%] aspect-square rounded-3xl border border-white/10 bg-black/60 relative overflow-hidden flex flex-col justify-center items-center perspective-inner">
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_hsla(120,100%,50%,0.08)_0%,_transparent_70%)]"></div>
            
            <div class="flex flex-col items-center gap-8 relative z-10 transform group-hover:scale-110 group-hover:translate-z-10 transition-transform duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
              
              <!-- Folder -->
              <div class="w-20 h-16 rounded-xl bg-blue-500/20 border border-blue-400/30 flex items-center justify-center relative shadow-[0_0_30px_rgba(59,130,246,0.2)]">
                 <div class="absolute -top-3 left-2 w-8 h-4 rounded-t-md bg-blue-500/20 border-t border-l border-blue-400/30"></div>
                 <div class="text-blue-400 font-mono text-xs font-bold">Template</div>
              </div>
              
              <!-- Flow line -->
              <div class="w-[2px] h-12 bg-gradient-to-b from-blue-500/50 via-white/40 to-green-500/50 relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-full bg-white opacity-0 group-hover:animate-flow-down"></div>
              </div>
              
              <!-- Globe / Server -->
              <div class="w-24 h-24 rounded-full bg-white flex items-center justify-center shadow-[0_0_40px_rgba(255,255,255,0.15)] group-hover:shadow-[0_0_60px_rgba(34,197,94,0.3)] transition-shadow duration-700">
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/></svg>
              </div>
              
              <div class="px-5 py-2 rounded-full bg-green-500/10 border border-green-500/30 text-green-400 text-sm font-mono font-bold opacity-0 group-hover:opacity-100 transform translate-y-4 group-hover:translate-y-0 transition-all duration-500 delay-300">
                En Ligne (100ms)
              </div>
            </div>
          </div>
        </article>

      </section>

      <!-- BOTTOM CTA -->
      <footer class="mt-32 mb-16 text-center scroll-3d-emerge">
        <h3 class="font-heading text-2xl font-bold text-white mb-6">Prêt à créer votre portfolio ?</h3>
        <p class="text-gray-400 max-w-md mx-auto mb-10">Vous n'avez plus besoin du fichier texte. Tout est là. Retournez à l'accueil pour accéder à vos templates.</p>
        <a href="/" class="group relative inline-flex items-center gap-3 px-12 py-5 font-bold text-gray-900 bg-[#00E5FF] rounded-2xl overflow-hidden transition-all duration-300 hover:scale-[0.98] shadow-[0_0_50px_rgba(0,229,255,0.4)]">
          <span class="absolute inset-0 bg-white/20 translate-y-[100%] group-hover:translate-y-0 transition-transform duration-300 ease-out"></span>
          <span class="relative z-10 text-lg tracking-tight">Accéder au Showcase</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="relative z-10 group-hover:translate-x-1 transition-transform"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </footer>

    </div>
  </main>
</Layout>

<style>
  /* Base Entrance Animation for Hero */
  .fade-in-up {
    animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Pulse Slow for background mesh */
  @keyframes pulseSlow {
    0%, 100% { opacity: 0.8; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.1); }
  }
  .animate-pulse-slow {
    animation: pulseSlow 8s ease-in-out infinite;
  }

  /* Ripple effect for triple click */
  @keyframes ripple {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(2.5); opacity: 0; }
  }
  .animate-ripple {
    animation: ripple 1.2s infinite ease-out;
  }

  /* Flow down effect for deployment */
  @keyframes flowDown {
    0% { transform: translateY(-100%); opacity: 1; }
    100% { transform: translateY(100%); opacity: 0; }
  }
  .animate-flow-down {
    animation: flowDown 1.5s infinite ease-in-out;
  }

  /* 3D Depth Utilities */
  .transform-style-3d {
    transform-style: preserve-3d;
  }
  .perspective-container {
    perspective: 1200px;
  }
  .perspective-inner {
    perspective: 800px;
    transform-style: preserve-3d;
  }
  .-translate-z-10 { transform: translateZ(-20px); }
  .translate-z-10 { transform: translateZ(20px); }
  .rotate-x-12 { transform: rotateX(12deg); }
  .rotate-x-\\[-10deg\\] { transform: rotateX(-10deg); }

  /* 3D Scroll-driven animations (CSS view-timeline) */
  @supports (animation-timeline: view()) {
    .scroll-3d-emerge {
      opacity: 0;
      animation: emerge3D linear both;
      animation-timeline: view();
      /* The element starts animating when its top edge enters the viewport */
      /* It finishes animating when it has covered 35% of the viewport */
      animation-range: entry 0% cover 35%;
    }

    @keyframes emerge3D {
      0% {
        opacity: 0;
        transform: perspective(1000px) translateZ(-150px) translateY(80px) rotateX(5deg);
        filter: blur(12px);
      }
      100% {
        opacity: 1;
        transform: perspective(1000px) translateZ(0) translateY(0) rotateX(0deg);
        filter: blur(0px);
      }
    }
  }

  /* Fallback for browsers that do not support view-timeline (Safari) */
  @supports not (animation-timeline: view()) {
    .scroll-3d-emerge {
      opacity: 0;
      animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      /* We could use IntersectionObserver here, but a simple animation delay is an okay fallback */
    }
    .scroll-3d-emerge:nth-child(1) { animation-delay: 0.2s; }
    .scroll-3d-emerge:nth-child(2) { animation-delay: 0.4s; }
    .scroll-3d-emerge:nth-child(3) { animation-delay: 0.6s; }
    
    footer.scroll-3d-emerge { animation-delay: 0.8s; }
  }
</style>
