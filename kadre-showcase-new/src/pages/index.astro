---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TemplateCard from '../components/TemplateCard.astro';

import fs from 'node:fs';
const templatesData = JSON.parse(fs.readFileSync('./src/data/templates.json', 'utf8'));
---

<Layout 
  title="Kadrify — Templates Portfolio Premium 2026"
  description="5 templates portfolio premium pour se démarquer en ligne. Destinés aux développeurs, designers, photographes, créatifs et freelances. Personnalisable sans code avec CMS intégré. Dès 15 500 FCFA."
  ogImage="/og-image.png"
>
  <Header />
  
  <main class="pt-[72px]">
    <!-- Hero Section -->
    <section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden py-20 sm:py-32 lg:py-48">
      <!-- Background Elements -->
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#060608]/80 to-[#060608] z-10"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,229,255,0.15),transparent_50%)] z-10"></div>
      </div>

      <!-- Content -->
      <div class="relative z-20 max-w-7xl mx-auto px-6 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-semibold text-gray-300 mb-8 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#00E5FF] animate-pulse"></span>
          Templates Premium 2026
        </div>
        
        <h1 class="text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-black font-heading text-white tracking-tight leading-[1.1] mb-6 md:mb-8">
          Votre portfolio <br class="hidden sm:block"/><span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00E5FF] to-[#80F2FF]">n'a jamais été aussi</span> puissant.
        </h1>
        
        <p class="text-lg sm:text-xl md:text-2xl text-gray-400 mb-10 md:mb-12 max-w-3xl mx-auto font-light leading-relaxed px-2 sm:px-0">
          5 designs premium pour développeurs, designers, photographes et créatifs. Personnalisable sans code en quelques minutes.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="#templates" class="w-full sm:w-auto px-8 py-4 bg-[#00E5FF] hover:bg-[#80F2FF] text-black font-bold rounded-xl transition-all duration-300 shadow-[0_0_40px_rgba(0,229,255,0.3)] hover:shadow-[0_0_60px_rgba(0,229,255,0.5)] hover:-translate-y-1">
            Explorer les Templates
          </a>
          <button onclick="document.getElementById('sandbox-modal').classList.remove('hidden'); document.getElementById('sandbox-modal').classList.add('flex')" class="w-full sm:w-auto px-8 py-4 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-semibold rounded-xl transition-all duration-300 backdrop-blur-md">
            Voir la Sandbox
          </button>
        </div>
      </div>
    </section>

    <!-- Templates Grid -->
    <section id="templates" class="py-24 px-6 relative">
      <div class="max-w-7xl mx-auto">
        <div class="mb-16">
          <h2 class="text-3xl md:text-5xl font-bold font-heading text-white mb-4">Collection Premium</h2>
          <p class="text-gray-400 text-lg">Choisissez le design qui correspond à votre expertise.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {templatesData.map((template: any) => (
            <TemplateCard {...template} />
          ))}
        </div>
      </div>
    </section>
    
    <!-- Feature Teaser -->
    <section id="features" class="py-24 px-6 border-t border-white/5 bg-gray-900/50 relative overflow-hidden">
      <!-- Glow -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#00E5FF]/10 rounded-full blur-[100px] pointer-events-none"></div>
      
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-12 relative z-10">
        <div class="md:w-1/2">
          <h2 class="text-3xl md:text-4xl font-bold font-heading text-white mb-6">Personnalisation sans limite. Zéro code.</h2>
          <p class="text-gray-400 text-lg mb-8">
            Testez vos couleurs, polices et données directement dans notre Sandbox interactive. Ce que vous voyez est ce que vous obtenez. Modifiez les textes en un clic et admirez le résultat en temps réel.
          </p>
          <button onclick="document.getElementById('sandbox-modal').classList.remove('hidden'); document.getElementById('sandbox-modal').classList.add('flex')" class="inline-flex items-center gap-2 px-6 py-3 font-semibold text-[#00E5FF] border border-[#00E5FF]/30 bg-[#00E5FF]/10 rounded-xl hover:bg-[#00E5FF]/20 transition-all hover:shadow-[0_0_20px_rgba(0,229,255,0.2)]">
            Ouvrir la Sandbox
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </button>
        </div>
        
        <!-- UI Mockup CMS -->
        <div class="md:w-1/2 w-full aspect-[4/3] bg-gray-900/80 backdrop-blur-xl rounded-2xl border border-white/10 shadow-2xl relative overflow-hidden flex flex-col group hover:-translate-y-2 transition-transform duration-500">
           <!-- Top bar -->
           <div class="h-10 border-b border-white/10 flex items-center px-4 gap-2 bg-black/40">
             <div class="w-3 h-3 rounded-full bg-red-500/50"></div>
             <div class="w-3 h-3 rounded-full bg-yellow-500/50"></div>
             <div class="w-3 h-3 rounded-full bg-green-500/50"></div>
             <div class="ml-4 text-xs font-mono text-gray-500">kadrify-cms-preview.app</div>
           </div>
           
           <div class="flex flex-1">
             <!-- Sidebar -->
             <div class="w-1/3 border-r border-white/10 p-4 flex flex-col gap-4 bg-black/20">
               <div class="h-6 w-24 bg-white/10 rounded-md"></div>
               <div class="h-4 w-full bg-white/5 rounded-md mt-4"></div>
               <div class="h-4 w-3/4 bg-white/5 rounded-md"></div>
               <div class="h-4 w-full bg-white/5 rounded-md"></div>
               
               <div class="mt-8 space-y-3">
                 <div class="flex gap-2">
                   <div class="w-6 h-6 rounded-full bg-[#00E5FF] shadow-[0_0_10px_rgba(0,229,255,0.5)] border border-white/20"></div>
                   <div class="w-6 h-6 rounded-full bg-[#8b5cf6] border border-white/20"></div>
                   <div class="w-6 h-6 rounded-full bg-[#ec4899] border border-white/20"></div>
                 </div>
                 <div class="h-8 w-full bg-[#00E5FF]/20 border border-[#00E5FF]/30 rounded-md flex items-center justify-center text-[10px] text-[#00E5FF] font-bold">THEME SETTINGS</div>
               </div>
             </div>
             
             <!-- Main Preview Area -->
             <div class="flex-1 p-6 flex flex-col items-center justify-center relative bg-gradient-to-br from-gray-900 to-black">
               <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:20px_20px]"></div>
               <div class="w-3/4 h-8 bg-white/10 rounded-lg backdrop-blur-sm mb-4 relative z-10"></div>
               <div class="w-1/2 h-4 bg-white/5 rounded-lg backdrop-blur-sm mb-8 relative z-10"></div>
               
               <div class="flex gap-4 relative z-10">
                 <div class="w-20 h-24 bg-gray-800 rounded border border-white/5"></div>
                 <div class="w-20 h-24 bg-[#00E5FF]/10 rounded border border-[#00E5FF]/30 shadow-[0_0_20px_rgba(0,229,255,0.1)]"></div>
                 <div class="w-20 h-24 bg-gray-800 rounded border border-white/5"></div>
               </div>
               
               <!-- Floating cursor -->
               <div class="absolute bottom-1/4 right-1/4 w-4 h-4 text-white drop-shadow-md z-20 animate-bounce">
                 <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2l12 11.2l-5.8.5l3.3 7.3l-2.25 1l-3.2-7.4l-4.4 4.8z"></path></svg>
               </div>
             </div>
           </div>
        </div>
      </div>
    </section>
  </main>
  
  <!-- Sandbox Selection Modal -->
  <div id="sandbox-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm px-4">
    <div class="bg-gray-900 border border-white/10 rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl relative">
      <button onclick="document.getElementById('sandbox-modal').classList.add('hidden'); document.getElementById('sandbox-modal').classList.remove('flex')" class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      
      <div class="p-8 border-b border-white/10">
        <h3 class="text-2xl font-bold text-white mb-2 font-heading">Sélectionner un Template</h3>
        <p class="text-gray-400">Quel design souhaitez-vous tester dans la Sandbox Kadrify ?</p>
      </div>
      
      <div class="p-4 max-h-[60vh] overflow-y-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {templatesData.map((template: any) => (
            <a href={`/sandbox?template=${template.id}`} class="flex items-center gap-4 p-3 rounded-xl hover:bg-white/5 border border-transparent hover:border-white/10 transition-all group">
              <div class="w-20 h-14 rounded-lg bg-black border border-white/10 overflow-hidden relative">
                <img src={template.thumbnail} alt={template.name} class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity" />
              </div>
              <div>
                <h4 class="font-bold text-white group-hover:text-[#00E5FF] transition-colors">{template.name}</h4>
                <p class="text-xs text-gray-500">{template.tags[0]} / {template.tags[1]}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
  
  <Footer />
</Layout>
