---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import fs from 'node:fs';

export function getStaticPaths() {
  const templatesData = JSON.parse(fs.readFileSync('./src/data/templates.json', 'utf8'));
  return templatesData.map((template: any) => ({
    params: { id: template.id },
    props: { template },
  }));
}

const { template } = Astro.props;
const checkoutSlug = template.id.replace(/^\d{2}-/, '');
const checkoutUrl = `https://vouhshop.aurakadre.com/products/${checkoutSlug}/checkout`;
const templateSeoDescription = `Découvrez le template portfolio "${template.name}" — ${template.description} Idéal pour ${template.forWho}. Personnalisable sans code avec CMS intégré. Dès 15 500 FCFA sur AuraKadre.`;
---

<Layout 
  title={`Template ${template.name} — Portfolio Développeur | AuraKadre`}
  description={templateSeoDescription}
  ogImage={template.thumbnail}
  schemaType="product"
  templateName={template.name}
  templatePrice={template.price}
>
  <Header />
  
  <main class="pt-[72px] min-h-screen">
    <!-- Breadcrumb -->
    <div class="border-b border-white/5 bg-gray-900/50">
      <div class="max-w-7xl mx-auto px-6 py-4 flex items-center gap-2 text-sm text-gray-500">
        <a href="/" class="hover:text-white transition-colors">Templates</a>
        <span>/</span>
        <span class="text-gray-300">{template.name}</span>
      </div>
    </div>

    <section class="max-w-7xl mx-auto px-6 py-12 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        
        <!-- Left: Image Preview -->
        <div class="space-y-6">
          <div class="aspect-video w-full rounded-2xl overflow-hidden border border-white/10 bg-gray-900 relative shadow-2xl group transition-all duration-[400ms] hover:border-white/30 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5),0_0_30px_rgba(0,229,255,0.15)]">
            <!-- Live Iframe Preview (Always Visible, active on hover via overlay) -->
            <div class="absolute inset-0 z-0 pointer-events-none">
              <iframe 
                src={`/templates/${template.id}/index.html`} 
                loading="lazy" 
                class="absolute top-0 left-0 border-none origin-top-left pointer-events-none"
                style="width: 200%; height: 200%; transform: scale(0.5);"
              ></iframe>
              <!-- Overlay fades on hover to reveal the live preview -->
              <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-950/40 to-transparent opacity-90 mix-blend-multiply transition-opacity duration-[800ms] ease-out group-hover:opacity-10"></div>
              <div class="absolute inset-0 shadow-[inset_0_0_40px_rgba(0,0,0,0.8)] pointer-events-none"></div>
            </div>
          </div>
          
          <div class="flex gap-4">
            <a href={`/sandbox?template=${template.id}`} class="flex-1 flex items-center justify-center gap-2 px-6 py-4 font-bold text-gray-900 bg-white rounded-xl hover:bg-gray-100 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h4l3-9 5 18 3-9h5"></path></svg>
              Tester la démo
            </a>
            <a href={checkoutUrl} target="_blank" class="flex-1 flex items-center justify-center gap-2 px-6 py-4 font-bold text-gray-900 bg-gradient-to-r from-[#00E5FF] to-[#80F2FF] rounded-xl hover:shadow-[0_0_20px_rgba(0,229,255,0.3)] transition-all">
              Acheter - 15 500 XAF
            </a>
          </div>
        </div>
        
        <!-- Right: Details -->
        <div class="flex flex-col justify-center">
          <div class="flex flex-wrap gap-2 mb-6">
            {template.tags.map((tag: string) => (
              <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider text-[#00E5FF] bg-[#00E5FF]/10 rounded-full border border-[#00E5FF]/20">
                {tag}
              </span>
            ))}
          </div>
          
          <h1 class="text-4xl md:text-5xl font-bold font-heading text-white mb-6">{template.name}</h1>
          <p class="text-xl text-gray-400 mb-12 leading-relaxed">
            {template.description}
          </p>
          
          <div class="space-y-10">
            <!-- Pour Qui -->
            <div>
              <h3 class="flex items-center gap-2 text-lg font-bold text-white mb-3 font-heading">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00E5FF]"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                Idéal pour qui ?
              </h3>
              <p class="text-gray-400 leading-relaxed pl-7">{template.forWho}</p>
            </div>
            
            <!-- Pourquoi -->
            <div>
              <h3 class="flex items-center gap-2 text-lg font-bold text-white mb-3 font-heading">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00E5FF]"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
                Pourquoi ce design ?
              </h3>
              <p class="text-gray-400 leading-relaxed pl-7">{template.why}</p>
            </div>
            
            <!-- Stack -->
            <div>
              <h3 class="flex items-center gap-2 text-lg font-bold text-white mb-3 font-heading">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00E5FF]"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                Technologies utilisées
              </h3>
              <div class="flex flex-wrap gap-2 pl-7">
                {template.stack.map((tech: string) => (
                  <span class="px-3 py-1.5 text-sm font-medium text-gray-300 bg-white/5 border border-white/10 rounded-lg">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
            
          </div>
        </div>
        
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
